# Backend Configuration
PROJECT_NAME="CarePulse AI"
VERSION="1.0.0"
ENVIRONMENT=development
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-key-in-production

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# MongoDB Configuration
MONGO_URI=mongodb://admin:secretpassword@localhost:27017/carepulse_db?authSource=admin
MONGO_DB_NAME=carepulse_db

# Qdrant Vector Database
VECTOR_DB_HOST=localhost
VECTOR_DB_PORT=6333
VECTOR_COLLECTION_NAME=healthcare_benefits

# PDPA & Security
MASK_LOGS=true
ENABLE_DATA_ENCRYPTION=true
